{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hapi",
  "mainBinaryName": "hapi-desktop",
  "version": "0.1.0",
  "identifier": "com.hapi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hapi",
        "width": 1160,
        "height": 750,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Hapi desktop client.",
    "longDescription": "Desktop client for the Hapi web console.",
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
